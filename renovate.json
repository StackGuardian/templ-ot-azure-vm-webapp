{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group GitLab CI image updates",
      "matchManagers": [
        "gitlab-ci"
      ],
      "groupName": "gitlab ci images"
    }
  ]
}
