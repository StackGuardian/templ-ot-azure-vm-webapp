    },
    "vm_size": {
      "type": "string",
      "default": "Standard_B2s_v2",
      "enum": [
        "Standard_B2s_v2",
        "Standard_B4s_v2",
        "Standard_D2s_v5",
        "Standard_D4s_v5",
        "Standard_D2as_v5",
        "Standard_D4as_v5"
      ],
      "enumNames": [
        "B2s v2 (2 vCPU, 8 GiB)",
        "B4s v2 (4 vCPU, 16 GiB)",
        "D2s v5 (2 vCPU, 8 GiB)",
        "D4s v5 (4 vCPU, 16 GiB)",
        "D2as v5 (2 vCPU, 8 GiB, AMD)",
        "D4as v5 (4 vCPU, 16 GiB, AMD)"
      ]
    },
    "advanced_settings": {
      "type": "object",
      "properties": {
        "show_advanced_settings": {
          "type": "boolean",
          "default": false
        }
      },
      "dependencies": {
        "show_advanced_settings": {
          "oneOf": [
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    false
                  ]
                }
              },
              "required": []
            },
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    true
                  ]
                },
                "vnet_cidr": {
                  "type": "string",
                  "default": "10.0.0.0/16"
                },
                "admin_username": {
                  "type": "string",
                  "default": "azureuser"
                },
                "instance_count": {
                  "default": 1,
                  "type": "number",
                  "multipleOf": 1,
                  "minimum": 1,
                  "maximum": 5
                },
                "encryption_at_host_enabled": {
                  "type": "boolean",
                  "default": false
                },
                "allowed_http_cidrs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "0.0.0.0/0"
                  ],
                  "uniqueItems": true
                },
                "log_retention_days": {
                  "type": "number",
                  "default": 90
                },
                "tags": {
                  "title": "Tags",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Additional tags for all resources",
                  "default": {}
                }
              },
              "required": [
                "instance_count"
              ]
            }
          ]
        }
      },
      "required": []
    }
  },
  "dependencies": {}
}
