{
  "type": "object",
  "title": "Azure Web App on VMs (Scale Set + App Gateway)",
  "required": [
    "ssh_public_key"
  ],
  "properties": {
    "ssh_public_key": {
      "type": "string"
    },
    "name_prefix": {
      "type": "string",
      "default": "demo",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },
    "location": {
      "type": "string",
      "default": "germanywestcentral",
